TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Central Europe: openapi.tuyaeu.com | Western Europe: openapi-weaz.tuya.com
TUYA_ENDPOINT=https://openapi.tuyaeu.com
# Palavra-passe (HTTP Basic) para o acesso pela rede local. Vazia = desligada.
WEB_USER=admin
WEB_PASSWORD=
# Login Google (OAuth2, opcional: exige HTTPS externo para o retorno). Sem credenciais fica desligado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails Google autorizados, separados por vírgulas (vazio = ninguém entra)
GOOGLE_ALLOWED_EMAILS=
# Endereço de retorno registado na Google (tem de ser HTTPS)
AUTH_REDIRECT_URI=https://jtx.ddns.net/power/auth/callback
# Prefixo de publicação (caminho do cookie de sessão)
WEB_PREFIX=/power
# Opcional: segredo do cookie de sessão (vazio = gerado em <pasta de dados>/.session_secret)
SECRET_KEY=
# true: pedidos da rede local, em HTTP e com um destes nomes, dispensam login. Só ligar depois de confirmar
# que o acesso externo exige mesmo login (ver README, «Autenticação»).
LAN_TRUSTED=false
LAN_HOSTS=lambdacore,lambdacore.lan,localhost,127.0.0.1
DB_PATH=data/tuya.db
# Hora local da descarga diária e dias de histórico na 1.ª descarga (Tuya guarda ~7 dias)
SYNC_HOUR=3
SYNC_INITIAL_DAYS=7
# Pôr a false se a sincronização for feita por cron (scripts/cron_sync.sh)
SYNC_IN_APP=true
# >0: sincronizar de N em N minutos (60 = de hora a hora, ideal num contentor); 0 = 1x por dia (SYNC_HOUR)
SYNC_INTERVAL_MINUTES=0
