{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tuya Power (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"],
      "python": "/mnt/storage1/conda/envs/tuya-power/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Tuya Power (sem reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8080"],
      "python": "/mnt/storage1/conda/envs/tuya-power/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Sincronização única",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/sync_once.py",
      "python": "/mnt/storage1/conda/envs/tuya-power/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
